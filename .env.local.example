# # Supabase — copie estes valores do painel do seu projeto (Settings > API)
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# # Service role key — Settings > API > Project API keys > service_role
# # NUNCA prefixar com NEXT_PUBLIC_ (isso a exporia no navegador).
# # Usada apenas no servidor. Com RLS habilitado (rode supabase/rls.sql),
# # essa é a única forma do app conseguir ler/escrever no banco.
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# # Senha de acesso ao painel — defina uma senha real antes de qualquer deploy
# # acessível pela internet. Deixar em branco desabilita a proteção
# # (use isso só em desenvolvimento local, nunca em produção).
# APP_PASSWORD=
