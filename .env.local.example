# Atlas — copie este arquivo para .env.local e preencha os valores:
#   cp .env.local.example .env.local
#
# As quatro variáveis abaixo são OBRIGATÓRIAS. O app não sobe sem as duas do
# Supabase, e sem APP_PASSWORD ele fica SEM AUTENTICAÇÃO NENHUMA.

# Supabase > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Settings > API > Project API keys > service_role
# NUNCA prefixar com NEXT_PUBLIC_ (isso a exporia no navegador).
# Usada apenas no servidor. Com RLS habilitado (rode supabase/rls.sql),
# essa é a única forma do app conseguir ler/escrever no banco.
SUPABASE_SERVICE_ROLE_KEY=

# Credencial de acesso ao painel — e-mail E senha, as duas obrigatórias.
# Não são contas de usuário: é UMA credencial da empresa, com duas partes.
# Não há cadastro, nem "quem fez o quê" (ver ARCHITECTURE.md §9).
#
# ATENÇÃO: se qualquer uma das duas ficar vazia, src/proxy.ts libera todas as
# rotas sem pedir login em desenvolvimento — e responde 503 em produção.
# Nunca deixe em branco em nada acessível pela rede.
#
# Trocar o e-mail OU a senha encerra todas as sessões abertas (o segredo que
# assina o cookie deriva das duas).
APP_EMAIL=
APP_PASSWORD=
