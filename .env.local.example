# Atlas — copie este arquivo para .env.local e preencha os valores:
#   cp .env.local.example .env.local
#
# As três variáveis abaixo são OBRIGATÓRIAS. O app não sobe sem as duas do
# Supabase, e sem APP_PASSWORD ele fica SEM AUTENTICAÇÃO NENHUMA.

# Supabase > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Settings > API > Project API keys > service_role
# NUNCA prefixar com NEXT_PUBLIC_ (isso a exporia no navegador).
# Usada apenas no servidor. Com RLS habilitado (rode supabase/rls.sql),
# essa é a única forma do app conseguir ler/escrever no banco.
SUPABASE_SERVICE_ROLE_KEY=

# Senha de acesso ao painel. Defina uma senha real antes de rodar.
# ATENÇÃO: se esta variável ficar vazia, src/proxy.ts libera todas as rotas
# sem pedir login — inclusive as que apagam dados. Nunca deixe em branco em
# nada que esteja acessível pela rede.
APP_PASSWORD=
